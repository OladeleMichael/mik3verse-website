{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowSSMParameterManagement",
      "Effect": "Allow",
      "Action": [
        "ssm:PutParameter",
        "ssm:GetParameter",
        "ssm:GetParameters",
        "ssm:GetParametersByPath",
        "ssm:DescribeParameters",
        "ssm:DeleteParameter",
        "ssm:AddTagsToResource"
      ],
      "Resource": [
        "arn:aws:ssm:*:*:parameter/mik3verse/*"
      ]
    }
  ]
}
